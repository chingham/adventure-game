        { "at": [12, 12, 0], "block": [12, 12, 1] },
        { "at": [14, 16, 1], "block": [8, 6, 1] },
        { "at": [18, 18, 2], "block": [2, 2, 1] },
        {
            "at": [10, 14, 0],
