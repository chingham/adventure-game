{
    "$schema": "level.schema.json",

    "textures": {
        "greyGrid": { "path": "Data/Textures/greybox-unit-darkgray.png" },
        //"greyGrid": { "path": "Data/test2.png" },
        "whiteGrid": { "path": "Data/Textures/greybox-unit-white.png" },
        "redGrid": { "path": "Data/Textures/greybox-unit-red.png" },
        //"redGrid": { "path": "Data/test.png" },
        "yellowGrid": { "path": "Data/Textures/greybox-unit-yellow.png" },
        "raindrop": { "path": "Data/Textures/raindrop.png", "adjust": { "brightness": 0.5 } },
    },
    "materials": {
        "environment": { "baseColorTexture": "greyGrid", "roughness": 0.9 },
        "neutral": { "baseColorTexture": "whiteGrid", "roughness": 0.8 },
        "danger": { "baseColorTexture": "redGrid", "roughness": 0.8 },
        "interactive": { "baseColorTexture": "yellowGrid", "roughness": 0.7 },
        "lamp-emissive": { "emissive": "#f7a452", "emissiveStrength": 7.0 },
        "window-emissive": { "emissive": "#f7a452", "emissiveStrength": 4.0 },
        "rain": { "particle": { "response": 1.0, "fade": 1.0, "stamp": "raindrop", "billboard": "velocity" } },
    },

    "view": {
        "environment": {
            //"gradient": { "horizon": "#6E6493", "zenith": "#1B2440", "ground": "#0E0F15" },
            "gradient": { "horizon": "#030404", "zenith": "#07070a", "ground": "#030404", "sunColor": "#1e1e2e" },
        },
        "effects": [
            { "bloom": { "threshold": 1.2, "radius": 1.3, "intensity": 0.22 } },
            { "film": { "vignette": 0.3 }, "space": "hdr" },
        ],
    },

    "prefabs": {
        "lamp-big": {
            "children": [
                {
                    "at": [0, 0, 0],
                    "block": [0.2, 0.2, 4],
                    "material": "environment",
                },
                {
                    "at": [0, 0.2, 3.8],
                    "block": [0.2, 0.2, 0.2],
                    "material": "environment",
                },
                {
                    "at": [0, 0.2, 3.7],
                    "block": [0.2, 0.2, 0.1],
                    "material": "lamp-emissive",
                    "light": {
                        "type": "spot",
                        "dir": [0, 0.4, -1],
                        "color": "#ffc581",
                        "intensity": 10.5,
                        //"shadows": true,
                        "range": 50,
                        "cone": [20, 60],
                        "shadows": true,
                    },
                },
            ],
        },
        "lamp-small": {
            "children": [
                {
                    "at": [0, 0, 0],
                    "block": [0.2, 0.2, 1],
                    "material": "environment",
                },
                {
                    "at": [0, 0, 1],
                    "block": [0.2, 0.2, 0.1],
                    "material": "lamp-emissive",
                },
                {
                    "at": [0.1, 0.1, 1.2],
                    "light": {
                        "type": "point",
                        "color": "#ffc581",
                        "intensity": 10.5,
                        //"shadows": true,
                        "range": 10,
                        "shadows": true,
                    },
                },
            ],
        },
    },

    "entities": [
        { "id": "spawn", "at": [-13, -10, 0], "rot": [0, 0, -60] },

        // Spawn interactable
        {
            "id": "inter",
            "name": "inter",
            "at": [-11, -9, 0],
            "material": "interactive",
            "block": [0.5, 0.5, 1.0],
            "interactable": {
                "at": [-10.75, -8.75, 1],
                "prompt": "Lorem ipsum",
                "emit": "inter-signal",
            },
        },

        // Sun and ground
        {
            "id": "sun",
            "light": {
                "type": "directional",
                "dir": [-0.4, -0.35, -0.85],
                "color": "#244054",
                "intensity": 1.5,
                "shadows": true,
            },
        },
        {
            "at": [0, -14, 0],
            "material": "danger",
            "mesh": "terrain",
            "solid": true,
        },

        // Rain emitter
        /*{
            "id": "rain",
            "at": [-13, -12, 30],
            "rot": [180, 5, 0],
            "particles": {
                "prewarm": 10,
                "rate": 5000,
                "emission": { "circle": { "radius": 20 } },
