        },
        {
            "at": [16, 18, 2],
            "material": "danger",
            "ramp": { "size": [2, 2, 1], "facing": "east" },
        },

        // Jump platforms
        { "at": [10, -3, 0], "block": [3, 3, 1] },
        { "at": [10, 1, 0], "block": [3, 3, 2] },
        { "at": [17, 1, 0], "block": [3, 3, 2] },
        { "at": [13, 1, 1], "block": [4, 3, 1] },
        { "at": [10, 5, 0], "block": [3, 3, 3] },

        // Obstacles
        { "at": [2, 0, 0], "pillar": { "r": 0.5, "h": 2.5 } },
        { "at": [-3, -4, 0], "pillar": { "r": 0.5, "h": 2.5 } },
        { "at": [4, -9, 0], "pillar": { "r": 0.5, "h": 2.3 } },

        // Moving platforms
        {
            "id": "shuttle",
            "name": "shuttle",
            "at": [13.5, 8, 0.375],
            "material": "danger",
            "block": [3, 3, 0.25],
            "mover": { "to": [15, -11.25, 0.5], "mode": "shuttle", "speed": 6, "dwell": 1 },
        },
        {
            "id": "elevator",
            "name": "elevator",
            "at": [13.25, -18.25, 0.375],
            "material": "danger",
            "block": [3, 3, 0.25],
            "mover": { "to": [14.75, -16.75, 12], "mode": "shuttle", "speed": 6, "dwell": 1 },
        },

        // Balance beam on two pillars
        { "id": "balance-beam-on-1", "at": [-16, -6, 0], "pillar": { "r": 0.5, "h": 2 } },
        { "id": "balance-beam-on-2", "at": [-16, 2, 0], "pillar": { "r": 0.5, "h": 2 } },
        {
            "id": "balance-beam-on-3",
            "at": [-16, -7, 2],
            "material": "interactive",
            "block": [1, 10, 0.25],
        },

        //---

        // Shop: Exterior
        { "at": [-11, 0, 0], "block": [3, 1, 3] },
        { "at": [-6, 0, 0], "block": [3, 1, 3] },
        { "at": [-4, 1, 0], "block": [1, 3, 3] },
        { "at": [-11, 1, 0], "block": [1, 3, 3] },
        { "at": [-11, 4, 0], "block": [8, 1, 3] },
        { "at": [-11, 0, 3], "block": [8, 5, 1] },
        { "at": [-10, -0.1, 1.5], "block": [1, 0.1, 1], "material": "window-emissive" },
        { "at": [-5, -0.1, 1.5], "block": [1, 0.1, 1], "material": "window-emissive" },
        { "at": [-11.1, 2, 1.5], "block": [0.1, 1, 1], "material": "window-emissive" },
        {
            "id": "shop-exterior-portal-a",
            "at": [-8, 0, 0],
            "portalEnd": {
                "w": 2,
                "h": 2.5,
                "facing": "south",
                "exitAt": [9998, -5, 0],
                "exitFacing": "north",
            },
        },
        {
            "id": "shop-exterior-portal-b",
            "at": [9998, -5, 0],
            "portalEnd": {
                "w": 2,
                "h": 2.5,
                "facing": "north",
                "exitAt": [-8, 0, 0],
                "exitFacing": "south",
            },
        },

        // The doorstep announces itself on the bus, and nothing listens yet
        {
            "id": "shop-doorstep",
            "name": "shop-doorstep",
            "at": [-8, -1.5, 0],
            "trigger": {
                "size": [2, 1.5, 2.5],
                "enter": "shop-doorstep",
                "exit": "shop-doorstep.left",
            },
        },

        // Shop: Interior
        {
            "id": "shop1",
            "name": "shop1",
            "at": [9991, -6, -1],
            "volume": [16, 20, 6],
            "camera": { "iso": true, "distance": 60, "fov": 0.3, "pivot": "center" },
            "fog": { "density": 0, "color": "#0E0F15" },
            "grade": { "saturation": 0.8, "warmth": -0.05 },
            "rain": { "intensity": 0 },
        },

        { "at": [9994, -4, -1], "block": [12, 12, 1] },
        { "at": [9997, -8, -1], "block": [4, 4, 1] },
        { "at": [9993, -5, 3], "block": [14, 1, 1] },
        { "at": [9994, 8, 0], "block": [5, 1, 3] },
        { "at": [10001, 8, 0], "block": [5, 1, 3] },
        {
            "id": "shop-door-panel",
            "name": "shop-door-panel",
            "at": [9999, 8, 0],
            "material": "danger",
            "block": [2, 1, 3],
            "interactable": {
                "at": [10000, 8, 1.2],
                "prompt": "Ouvrir la porte",
                "emit": "shop-door",
                "reach": 1.8,
            },
        },
        { "at": [9993, -5, 0], "block": [1, 14, 3] },
        { "at": [10006, -5, 0], "block": [1, 14, 3] },
        { "at": [9994, -5, 0], "block": [4, 1, 3] },
        { "at": [10000, -5, 0], "block": [6, 1, 3] },
        {
            "at": [9996, 4, 0],
            "material": "interactive",
            "block": [8, 2, 1],
        },
        { "at": [9995, -2, 0], "pillar": { "r": 0.5, "h": 3 } },
        { "at": [10004, -2, 0], "pillar": { "r": 0.5, "h": 3 } },

        // Shop: Chest
        {
            "id": "chest",
            "name": "chest",
            "at": [9998, 0, 0],
            "material": "interactive",
            "block": [1, 1, 0.8],
            "interactable": {
                "at": [9998.5, 0.5, 0.8],
                "prompt": "Fouiller le coffre",
                "emit": "chest-shop",
                "once": true,
            },
        },

        // Shop: Back room, behind the locked door
        { "at": [9998, 9, -1], "block": [4, 4, 1] },
        { "at": [9997, 9, 0], "block": [1, 5, 3] },
        { "at": [10002, 9, 0], "block": [1, 5, 3] },
        { "at": [9997, 13, 0], "block": [6, 1, 3] },
        {
            "at": [9999.5, 11, 0],
            "material": "interactive",
            "block": [1, 1, 1],
        },

        // Rules: hearing a signal runs these steps
        // A pressure pad is a sensor, a sink and a call: the sequence is what ties the three together.
        // Emitting after the sink means what it then waits for cannot have been said already.
        {
            "id": "seq-tower-press",
            "sequence": {
                "on": "tower-press",
                "steps": [
                    { "move": { "id": "tower-pad", "by": [0, 0, -0.15], "s": 0.12 } },
                    { "emit": "tower-call" },
                    { "waitSignal": "tower-call.done" },
                    { "move": { "id": "tower-pad", "by": [0, 0, 0.15], "s": 0.12 } },
                ],
            },
        },

        {
            "id": "seq-lift-press",
            "sequence": {
                "on": "lift-press",
                "steps": [
                    { "move": { "id": "lift-pad", "by": [0, 0, -0.15], "s": 0.12 } },
                    { "emit": "lift-call" },
                    { "waitSignal": "lift-call.done" },
                    { "move": { "id": "lift-pad", "by": [0, 0, 0.15], "s": 0.12 } },
                ],
            },
        },

        {
            "id": "seq-chest-shop",
            "sequence": {
                "on": "chest-shop",
                "steps": {
                    "cutscene": [
                        { "face": {} },
                        { "wait": 0.5 },
                        { "set": "shop-key" },
                        { "notice": "Clé du magasin obtenue" },
                        { "wait": 0.4 },
                    ],
                },
            },
        },

        {
            "id": "seq-shop-door",
            "sequence": {
                "on": "shop-door",
                "steps": [
                    { "face": {} },
                    {
                        "if": {
                            "flag": "shop-key",
                            "then": {
                                "cutscene": [
                                    { "notice": "La porte s'ouvre" },
                                    { "disable": "shop-door-panel" },
                                    {
                                        "move": {
                                            "id": "shop-door-panel",
                                            "by": [0, 0, -3.1],
                                            "s": 1.4,
                                        },
                                    },
                                    { "set": "shop-door-open" },
                                ],
                            },
                            "else": { "notice": "C'est verrouillé." },
                        },
                    },
                ],
            },
        },

        {
            "id": "seq-dialogue",
            "sequence": {
                "on": "inter-signal",
                "steps": {
                    "if": {
                        "flag": "shop-door-open",
                        "then": {
                            "say": {
                                "speaker": "Twinsen",
                                "pages": ["La porte est ouverte, ce coffre est vraiment [shake]mystérieux[/shake]."],
                            },
                        },
                        "else": {
                            "if": {
                                "flag": "shop-key",
                                "then": {
                                    "say": {
                                        "speaker": "Twinsen",
                                        "pages": [
                                            "J'ai une [color=#ffc749][glow]clé[/glow][/color], à quoi sert-elle ?",
                                        ],
                                    },
                                },
                                "else": {
                                    "say": {
                                        "speaker": "Twinsen",
                                        "pages": [
                                            "Il semblerait qu'il y ait un [wave]coffre[/wave] dans ce magasin.",
                                            "Il est peut-être verrouillé, mais je devrais pouvoir le fouiller.",
                                        ],
                                    },
                                },
                            },
                        },
                    },
                },
            },
        },
    ],
}
