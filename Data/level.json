  "sequences": [
    // A pressure pad is a sensor, a sink and a call: the sequence is what ties the three together.
    // Emitting after the sink means what it then waits for cannot have been said already.
    { "on": "tower-press", "steps": [
      { "do": "move", "id": "tower-pad", "by": [0, 0, -0.15], "s": 0.12 },
      { "do": "emit", "signal": "tower-call" },
      { "do": "waitSignal", "signal": "tower-call.done" },
      { "do": "move", "id": "tower-pad", "by": [0, 0, 0.15], "s": 0.12 }
    ] },

    { "on": "lift-press", "steps": [
      { "do": "move", "id": "lift-pad", "by": [0, 0, -0.15], "s": 0.12 },
      { "do": "emit", "signal": "lift-call" },
      { "do": "waitSignal", "signal": "lift-call.done" },
      { "do": "move", "id": "lift-pad", "by": [0, 0, 0.15], "s": 0.12 }
    ] },

    { "on": "chest-shop", "steps": [
      { "do": "gate" },
      { "do": "face" },
      { "do": "wait", "s": 0.5 },
      { "do": "set", "flag": "shop-key" },
      { "do": "toast", "text": "Clé du magasin obtenue" },
      { "do": "wait", "s": 0.4 },
      { "do": "release" }
    ] },

    { "on": "shop-door", "steps": [
      { "do": "face" },
      { "do": "if", "flag": "shop-key",
        "then": [
          { "do": "gate" },
          { "do": "toast", "text": "La porte s'ouvre" },
          { "do": "disable", "id": "shop-door-panel" },
          { "do": "move", "id": "shop-door-panel", "by": [0, 0, -3.1], "s": 1.4 },
          { "do": "release" }
        ],
        "else": [
          { "do": "toast", "text": "C'est verrouillé." }
        ] }
    ] }
  ]
}
